# Sincronização entre dispositivos — OPCIONAL.
#
# Sem esta variável o app roda 100% local no navegador (IndexedDB), do jeito
# que sempre funcionou. Ao defini-la, aparece a opção de criar conta e o acervo
# passa a sincronizar entre computador e celular.
#
# As tabelas são criadas sozinhas na primeira execução.

# Postgres gerenciado (Supabase, Neon, RDS, Railway…).
# Em provedores com pool de conexões, prefira a URL do pooler (porta 6543 no
# Supabase) — cada instância do app abre até 8 conexões.
# DATABASE_URL=postgres://usuario:senha@host:5432/banco

# Postgres local, sem TLS:
# DATABASE_URL=postgres://app@127.0.0.1:5432/referencias?sslmode=disable

# SQLite em arquivo, para quem hospeda o próprio servidor.
# O diretório precisa ser um volume persistente — num container efêmero o
# arquivo some junto com o container.
# DATABASE_URL=file:./data/referencias.db
